<div class="row">
    <div class="col-sm-12 form-group location-preferences-block{% if not form.locationPreferences.vars.valid %} has-error{% endif %}">
        <p class="location-preferences-help">
            Classez les sites qui vous intéressent par ordre de préférence (1 = votre choix principal).
            Utilisez les flèches pour modifier l'ordre, ou indiquez les sites qui ne vous intéressent pas.
        </p>

        <ol id="location-preferences-list" class="location-preferences-list">
            {% for preferenceForm in form.locationPreferences %}
                {% set location = preferenceForm.vars.data.location %}
                {% set isExcluded = preferenceForm.vars.data.excluded %}
                {% set siteAddress = location.fullAddress ?: location.city %}
                <li class="location-preference-item{% if isExcluded %} is-excluded{% endif %}">
                    <span class="js-preference-rank-label location-preference-rank">{{ isExcluded ? '—' : preferenceForm.vars.data.rank }}</span>
                    <div class="location-preference-info">
                        <div class="location-preference-head">
                            <h3 class="location-preference-name">{{ location.name }}</h3>
                            <span class="location-preference-badges">
                                {% if location.isErp %}
                                    <span class="pu-badge pu-badge--erp">ERP</span>
                                {% endif %}
                                {% if isExcluded %}
                                    <span class="pu-badge pu-badge--excluded js-excluded-badge">Ne m'intéresse pas</span>
                                {% endif %}
                            </span>
                        </div>
                        {% if siteAddress %}
                            <span class="location-preference-address">
                                <i class="fas fa-location-dot" aria-hidden="true"></i>
                                {{ siteAddress }}
                            </span>
                        {% endif %}
                        {% if location.availability %}
                            <span class="location-preference-meta">Durée du projet&nbsp;: {{ location.availability }}</span>
                        {% endif %}
                    </div>
                    <div class="location-preference-actions">
                        <button type="button" class="btn btn-default btn-xs js-move-preference-up" title="Monter">
                            <i class="fa fa-chevron-up"></i>
                        </button>
                        <button type="button" class="btn btn-default btn-xs js-move-preference-down" title="Descendre">
                            <i class="fa fa-chevron-down"></i>
                        </button>
                        <button type="button" class="btn btn-default btn-xs js-exclude-location" title="Ce site ne m'intéresse pas">
                            <i class="fa fa-ban"></i>
                        </button>
                        <button type="button" class="btn btn-default btn-xs js-restore-location" title="Réintégrer au classement" style="display: none;">
                            <i class="fa fa-undo"></i>
                        </button>
                    </div>
                    <span class="location-preference-hidden-fields">
                        {{ form_widget(preferenceForm.rank) }}
                        {{ form_widget(preferenceForm.excluded) }}
                        {{ form_widget(preferenceForm.location, { attr: { class: 'js-preference-location-input' } }) }}
                    </span>
                </li>
            {% endfor %}
        </ol>

        {{ form_errors(form.locationPreferences) }}
    </div>
</div>
