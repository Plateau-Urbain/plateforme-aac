  <div class="white"> 
        <div class="container"> 
<div class="col-sm-12 ">
 <div class="titre-page-hr">
    <h1>{{ space.name }}</h1>
    <div class="img-aac"><img src="{{ asset('images/groupe_1051.png') }}" alt="Plateau Urbain" /></div>
 </div>
</div>
<div class="row">
  <!-- BEGIN MAIN CONTENT -->
  <div class="col-sm-12">
    <h1 class="property-title">
    {#  {{ space.name }} {% if space.size is not empty %}à partir de {{ space.minSize }}m<sup>2</sup>{% endif %}
       <small>{{ space.city }} ({{ space.zipCode|slice(0,2)}})</small> #}
    </h1>
  </div>
</div>

<div class="row row-show-layout">
  
    <div class="sidebar col-xs-12 col-md-4 sticky">
       <h6><a href="{{ path('search_index') }}" class="red"><span class="sub-arrow"><i class="fa fa-square"></i></span>Tous les appels à candidatures</a></h6>
    <div class="content ">
      <h6>en bref</h6>
      <p class="pu-label">Commune&nbsp;: {{ space.displayCity|default(space.city) }}{% if not space.isMultiLocation and space.displayZipCode|default(space.zipCode) %} ({{ (space.displayZipCode|default(space.zipCode))|slice(0,2) }}){% endif %}</p>
      <p class="pu-label">Type de locaux&nbsp;: {{ space.type }}</p>
       <p class="pu-label">Bailleur&nbsp;: {% if space.owner %}
        {% if space.owner.website %}
          <a href="{{ space.owner.website }}" target="_blank">{{ space.owner.company }}</a>
        {% else %}
          {{ space.owner.company }}
        {% endif %}
      {% else %}
          Sans bailleur
      {% endif %}
      </p>

    <div class="pu-price-zone ">
    <p class="pu-label">Prix&nbsp;: </sup>
            {% if space.priceText %}
                {{ space.priceText }}
            {% else %}
                À partir de {{ (space.price * 12)|number_format(2, ',', ' ')|replace({',00': ''}) }} € / m<sup>2</sup> / an
                <br />Soit {{ space.price|number_format(2, ',', ' ')|replace({',00': ''}) }} € / m<sup>2</sup> / mois
            {% endif %}
            </p>
    
      {#   <dl class="dl-horizontal">
  
          <dd>
            <span class="pu-title"><strong>{{ space.parcels | length }}</strong> espaces</span>
            De {{ space.minSpace }} m<sup>2</sup> à {{ space.maxSpace }} m<sup>2</sup>
            <a href="#parcels">Voir la répartition des espaces</a>
          </dd>
        </dl> #} 
            {% if not space.isMultiLocation %}
            <p class="pu-label">Durée du projet&nbsp;: {{ space.availability }}</p>
            {% endif %}
            {% if space.nbSpaces or space.minSpace or space.maxSpace %}
            <p class="pu-label">
              Surfaces&nbsp;:
              {% if space.nbSpaces %}{{ space.nbSpaces }} espace(s){% endif %}
              {% if space.minSpace or space.maxSpace %}
                de {{ space.minSpace|default('?') }} m<sup>2</sup> à {{ space.maxSpace|default('?') }} m<sup>2</sup>
              {% endif %}
            </p>
            {% endif %}
     
    </div>
</div>
  

    <div class="pu-apply-zone">
      {% if space.isMultiLocation %}
      <h5 class="center apply-date-show pu-apply-title">Candidatures ouvertes</h5>
      {% set sitesCount = space.activeLocations|length %}
      {% if sitesCount > 1 %}
      <div class="pu-apply-sites">
        <span class="pu-apply-sites-count">
          <i class="fas fa-location-dot" aria-hidden="true"></i>
          {{ sitesCount }} sites proposés
        </span>
        <p class="pu-apply-sites-text">
          Choisissez un ou plusieurs sites et classez-les par ordre de préférence dans votre dossier de candidature.
        </p>
      </div>
      {% endif %}
      {% else %}
      <p class="center">Date limite de candidature</p>
      <h5 class="center apply-date-show">
        {{ space.limitAvailability|localizeddate('long', 'none', 'fr') }} à {{ space.limitAvailability|date('H') }}h{{ space.limitAvailability|date('i') }}
      </h5>
      {% endif %}
      <p class="center">
        {% if not space.submitted and not space.enabled %}
          <a href="{{ path('space_manager_edit', { 'id': space.id }) }}" class="btn btn-line-19">
            {{ "Modifier l'espace"}}
          </a>
        {% elseif space.submitted and not space.enabled and is_granted('ROLE_ADMIN') %}
          <a href="{{ path('space_manager_edit', { 'id': space.id }) }}" class="btn btn-line-19">
            {{ "Modifier l'espace"}}
          </a>
        {% elseif space.isClosed() %}
        {% elseif application is defined and application is not null and not application.isDraft %}
          <a href="{{ path('my_application_show', { 'id': application.id }) }}" class="btn btn-line-19">
            <span>{{ 'Voir votre candidature !'}}</span>
          </a>
        {% elseif not is_granted('ROLE_OWNER') or not app.user.isProprio() %}
          {% if not app.user %}
            <div class="auth-buttons">
              <a href="{{ path('app_login', {'next': path('space_apply', {'space': space.id})}) }}" class="btn btn-line-19">
                <span>Se connecter</span>
              </a>
              <a href="{{ path('security_profil') }}" class="btn btn-line-19">
                <span>Créer un compte</span>
              </a>
            </div>
            <p class="center" style="margin-top:8px">Vous devez avoir un compte pour candidater.</p>
          {% else %}
            {% if not app.user.isProfileComplete() %}
              <a href="{{ path('security_profil', {'next': path('space_apply', {'space': space.id})}) }}" class="btn btn-line-19">
                <span>{% if app.user.firstname is empty %}Veuillez compléter votre profil{% else %}Veuillez finaliser votre profil{% endif %}</span>
              </a>
              <p class="center" style="margin-top:8px">Votre profil doit être complet pour candidater.</p>
            {% else %}
              <a href="{{ path('space_apply', { 'space': space.id }) }}" class="btn btn-line-19">
                <span>{{ 'Je candidate'}}</span>
              </a>
            {% endif %}
          {% endif %}
        {% endif %}
      </p>
      {% if application is defined and application is not null and not application.isDraft %}
 
    {% if application.space.isClosed %}
      <p class="center">Ce projet est désormais clôturé.</p>
    {% endif %}
      <p class="center">
        Vous avez envoyé votre dossier de candidature pour cet espace le {{ application.created|date('d/m/Y') }}
      </p>
 
  

{% endif %}
    </div>
  </div>


<div class="main show col-xs-12 col-md-8">
    <div id="property-detail-wrapper" class="style1">
     {#  {% if space.isClosed %}
        <img src="{{ asset('/bundles/app/images/closed.png') }}" alt="closed" class="closed" />
      {% endif %} #}


      {% if space.pics|length > 0 %}
      <div class="pu-gallery-wrapper">
        {# --- Carousel principal --- #}
        <div id="spaceCarousel" class="carousel slide" data-ride="carousel" data-interval="false">

          {# Indicateurs (bullets) #}
          {% if space.pics|length > 1 %}
          <ol class="carousel-indicators">
            {% for p in space.pics %}
              <li data-target="#spaceCarousel" data-slide-to="{{ loop.index0 }}"{% if loop.first %} class="active"{% endif %}></li>
            {% endfor %}
          </ol>
          {% endif %}

          {# Slides #}
          <div class="carousel-inner" role="listbox">
            {% for p in space.pics %}
              <div class="item{% if loop.first %} active{% endif %}">
                <img src="{{ vich_uploader_asset(p, 'file') }}" alt="{{ space.name }}" />
              </div>
            {% endfor %}
          </div>

          {# Flèches de navigation #}
          {% if space.pics|length > 1 %}
          <a class="left carousel-control" href="#spaceCarousel" role="button" data-slide="prev">
            <span class="glyphicon glyphicon-chevron-left" aria-hidden="true"></span>
            <span class="sr-only">Précédent</span>
          </a>
          <a class="right carousel-control" href="#spaceCarousel" role="button" data-slide="next">
            <span class="glyphicon glyphicon-chevron-right" aria-hidden="true"></span>
            <span class="sr-only">Suivant</span>
          </a>
          {% endif %}
        </div>

        {# --- Vignettes cliquables --- #}
        {% if space.pics|length > 1 %}
        <div class="pu-gallery-thumbs">
          {% for p in space.pics %}
            <div class="pu-gallery-thumb{% if loop.first %} active{% endif %}" data-target="#spaceCarousel" data-slide-to="{{ loop.index0 }}">
              <img src="{{ vich_uploader_asset(p, 'file') }}" alt="{{ space.name }} – photo {{ loop.index }}" />
            </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endif %}

    </div>





    {% if space.isMultiLocation %}
      {% if space.description|striptags|replace({'&nbsp;': ' '})|trim is not empty %}
      <h4>Présentation générale</h4>
      <div class="pu-col-container content-block">
        <div>{{ space.description | raw }}</div>
      </div>
      {% endif %}
    {% else %}
    <h4 >
      {{ 'Descriptif du projet' }}
    </h4>
    <div class="pu-col-container content-block">
      <p>{{ space.description | raw }}</p>
    </div>

    <h4>
      {{ 'Activités recherchées' }}
    </h4>
    <div class="pu-col-container content-block">
      <p>{{ space.activityDescription | raw }}</p>
    </div>
    {% endif %}

    {% if space.isMultiLocation and space.locations|length > 0 %}
    <h4>Site(s) proposé(s)</h4>
    <div class="pu-col-container content-block">
        <p class="text-muted aac-map-hint"><i class="fas fa-location-dot"></i> Cliquez sur un repère pour afficher le détail du site.</p>
        <div id="aac-locations-map"></div>
    </div>

    <div class="pu-col-container content-block">
        <div class="pu-sites-accordion">
            {% for location in space.locations %}
            {% set siteVisits = space.visits|filter(v => v.location and v.location.id == location.id) %}
            <details class="pu-site{% if location.suspended %} pu-site--suspended{% endif %}" id="site-{{ location.id }}"{% if loop.first %} open{% endif %}>
                <summary class="pu-site-summary">
                    <span class="pu-location-index">{{ loop.index }}</span>
                    <span class="pu-site-summary-main">
                        <h3 class="pu-site-name">{{ location.name }}</h3>
                        {% set siteAddress = location.fullAddress ?: location.city %}
                        {% if siteAddress %}
                            <span class="pu-site-summary-address">
                                <i class="fas fa-location-dot" aria-hidden="true"></i>
                                {{ siteAddress }}
                            </span>
                        {% endif %}
                        {% if location.availability %}
                            <span class="pu-site-summary-meta">Durée du projet&nbsp;: {{ location.availability }}</span>
                        {% endif %}
                    </span>
                    <span class="pu-location-badges">
                        {% if location.erp %}
                            <span class="pu-badge pu-badge--erp">ERP</span>
                        {% endif %}
                        {% if location.suspended %}
                            <span class="pu-badge pu-badge--suspended">Suspendu</span>
                        {% endif %}
                    </span>
                    <i class="fas fa-chevron-down pu-site-chevron" aria-hidden="true"></i>
                </summary>

                <div class="pu-site-body">
                    {% if location.suspended and location.suspensionMessage %}
                        <div class="pu-location-suspension-notice">
                            <i class="fas fa-circle-pause" aria-hidden="true"></i>
                            <div>{{ location.suspensionMessage | raw }}</div>
                        </div>
                    {% endif %}

                    {% if location.description %}
                        <h4>Descriptif du projet</h4>
                        <div class="pu-site-text">{{ location.description | raw }}</div>
                    {% endif %}

                    {% if location.activityDescription %}
                        <h4>Activités recherchées</h4>
                        <div class="pu-site-text">{{ location.activityDescription | raw }}</div>
                    {% endif %}

                    {% if siteVisits|length %}
                        <h4>Visites prévues</h4>
                        <ul class="pu-site-visits">
                            {% for v in siteVisits %}
                                <li>
                                    <i class="fas fa-calendar" aria-hidden="true"></i>
                                    {{ v.visitDate|date('d/m/Y') }} de {{ v.startTime|date('H:i') }} à {{ v.endTime|date('H:i') }}
                                </li>
                            {% endfor %}
                        </ul>
                        <p class="pu-site-note">Si votre candidature est sélectionnée, vous recevrez un mail pour vous inscrire à l’une de ces visites (la visite du site est obligatoire).</p>
                    {% endif %}

                    <div class="pu-site-actions">
                        {% if location.aacDocumentName %}
                            <a class="pu-site-action pu-site-action--primary" href="{{ vich_uploader_asset(location, 'aacDocument') }}" target="_blank" rel="noopener">
                                <i class="far fa-file-pdf" aria-hidden="true"></i>
                                Télécharger l'appel à candidatures
                            </a>
                        {% endif %}
                        {% if location.planDocumentName %}
                            <a class="pu-site-action" href="{{ vich_uploader_asset(location, 'planDocument') }}" target="_blank" rel="noopener">
                                <i class="far fa-file-pdf" aria-hidden="true"></i>
                                Répartition des espaces
                            </a>
                        {% endif %}
                        {% if location.faqDocumentName %}
                            <a class="pu-site-action" href="{{ vich_uploader_asset(location, 'faqDocument') }}" target="_blank" rel="noopener">
                                <i class="far fa-circle-question" aria-hidden="true"></i>
                                F.A.Q
                            </a>
                        {% endif %}
                        <button type="button" class="pu-site-action js-show-site-on-map" data-location-id="{{ location.id }}">
                            <i class="fas fa-map-location-dot" aria-hidden="true"></i>
                            Voir sur la carte
                        </button>
                    </div>
                </div>
            </details>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {% set globalVisits = space.isMultiLocation ? space.visits|filter(v => not v.location) : space.visits %}
    {% if globalVisits | length %}
    <h4>
      Dates et horaires des visites prévues
    </h4>
    <div class="pu-col-container content-block">
      <p>
        {%- if space.isMultiLocation -%}
          Si votre candidature est sélectionnée, vous recevrez un mail pour vous inscrire à l’une de nos visites (la visite du site est obligatoire).
        {%- else -%}
          À la clôture de l’AAC vous recevrez un mail pour vous inscrire à l’une de nos visites (la visite du site est obligatoire).
        {%- endif -%}
      </p>
      <ul class="property-amenities-list">
        {% for v in globalVisits %}
          <li>
            <i class="fas fa-calendar" aria-hidden="true" style="margin-right:8px;"></i>
            {{ v.visitDate|date('d/m/Y') }} de {{ v.startTime|date('H:i') }} à {{ v.endTime|date('H:i') }}
          </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
 
  {% set fileAac = space.getDocs('document_aac') %}
  {% set filePlan = space.getDocs('document_plan') %}
  {% set fileFaq = space.getDocs('document_faq') %}
  {% set hasAac = not space.isMultiLocation and fileAac|length > 0 and fileAac[0].fileName is not empty %}
  {% set hasPlan = not space.isMultiLocation and filePlan|length > 0 and filePlan[0].fileName is not empty %}
  {% set hasFaq = not space.isMultiLocation and fileFaq|length > 0 and fileFaq[0].fileName is not empty %}
  {% set hasRessources = hasAac or hasPlan or hasFaq %}

  {% if hasRessources %}
  <h4>
      {{ 'Documents ressources' }}
    </h4>
    <div class="pu-col-container content-block ressources">
          {% if hasAac %}
          <div class="ressources-item grey">
            <div class="fd ressources-fd"><div class="pdf-appel"></div></div>
            <div class="lien-pdf red">
                <p>
                    <a class="red" href="{{ vich_uploader_asset(fileAac[0], 'file') }}" target="_blank">
                        Télécharger l'appel à candidatures
                    </a>
                </p>
            </div>
          </div>
          {% endif %}
          {% if hasPlan %}
          <div class="ressources-item grey">
           <div class="fd ressources-fd"><img src="{{ asset('bundles/app/images/groupe-repartion-espace.png') }}" alt="Répartition des espaces" /></div>
           <div class="lien-pdf red">
               <p>
                   <a class="red" href="{{ vich_uploader_asset(filePlan[0], 'file') }}" target="_blank">
                       Répartition des espaces
                   </a>
               </p>
           </div>
        </div>
          {% endif %}
          {% if hasFaq %}
          <div class="ressources-item grey">
           <div class="fd ressources-fd"><img src="{{ asset('bundles/app/images/groupe-faq.png') }}" alt="F.A.Q" /></div>
           <div class="lien-pdf red">
               <p>
                   <a class="red" href="{{ vich_uploader_asset(fileFaq[0], 'file') }}" target="_blank">
                       F.A.Q
                   </a>
               </p>
           </div>
        </div>
          {% endif %}
     </div>
  {% endif %}


    {% if space.hasTagType(constant('App\\Entity\\SpaceAttribute::STATUS_INCLUDED')) %}
      <h4>
        {{ 'Prestations et services' }}
      </h4>
      <div class="pu-col-container content-block">
        <ul class="property-amenities-list">
          {% for t in space.tags %}
            {% if t.isIncluded %}
              <li class="enabled">{{ t.attribute }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% if space.hasTagType(constant('App\\Entity\\SpaceAttribute::STATUS_EXPECTED')) %}
      <h4>
        {{ 'À prévoir' }}
      </h4>
      <div class="pu-col-container content-block">
        <ul class="property-amenities-list">
          {% for t in space.tags %}
            {% if t.isExpected %}
              <li class="disabled">{{ t.attribute }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% if space.usageRestriction %}
      <h4>
        {{ 'Mentions / restrictions d\'usage' }}
      </h4>
      <div class="pu-col-container content-block desc-mention">
        <p>{{ space.usageRestriction | nl2br }}</p>
      </div>
    {% endif %}
</div>
</div>
</div>
<div class="content plusinfos">
    <div class="container">
        <div class="row pu-home-content info">

            <div class="col-xs-12 col-md-8 col-lg-8">
                <h4>Vous souhaitez obtenir plus d'informations</h4>
            </div>
            <div class="col-xs-12 col-md-4 col-lg-4  btn-right">
                <a href='https://www.plateau-urbain.com/contactez-nous/' target="_blank" class='btn btn-line'><span>Contactez-nous</span></a>
            </div>

    </div>
</div>
</div>
</div>
</div>
{% endblock body %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .auth-buttons {
            display: flex;
            flex-direction: column;
            gap: 10px;
            align-items: center;
        }
        .auth-buttons .btn {
            width: 100%;
            max-width: 200px;
        }

        /* --- Galerie photos (Bootstrap Carousel + vignettes) --- */
        .pu-gallery-wrapper {
            margin-bottom: 20px;
        }

        /* Image principale */
        #spaceCarousel .item img {
            width: 100%;
            height: 420px;
            object-fit: cover;
            object-position: center;
            display: block;
        }

        /* Flèches de navigation */
        #spaceCarousel .carousel-control {
            background-image: none;
            width: 40px;
            opacity: 1;
        }
        #spaceCarousel .carousel-control .glyphicon {
            color: #fff;
            font-size: 22px;
            text-shadow: 0 1px 4px rgba(0,0,0,0.6);
            top: 50%;
            transform: translateY(-50%);
            margin: 0;
        }

        /* Indicateurs (bullets) */
        #spaceCarousel .carousel-indicators {
            bottom: 8px;
        }
        #spaceCarousel .carousel-indicators li {
            background-color: rgba(255,255,255,0.55);
            border: 1px solid rgba(255,255,255,0.8);
            width: 10px;
            height: 10px;
        }
        #spaceCarousel .carousel-indicators .active {
            background-color: #fff;
            width: 12px;
            height: 12px;
        }

        /* Vignettes cliquables */
        .pu-gallery-thumbs {
            display: flex;
            gap: 6px;
            margin-top: 6px;
            flex-wrap: wrap;
        }
        .pu-gallery-thumb {
            flex: 0 0 auto;
            width: 80px;
            height: 56px;
            cursor: pointer;
            border: 2px solid transparent;
            border-radius: 3px;
            overflow: hidden;
            opacity: 0.65;
            transition: opacity 0.2s, border-color 0.2s;
        }
        .pu-gallery-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .pu-gallery-thumb:hover {
            opacity: 0.9;
        }
        .pu-gallery-thumb.active {
            border-color: #c0392b;
            opacity: 1;
        }

        @media (max-width: 768px) {
            #spaceCarousel .item img { height: 220px; }
            .pu-gallery-thumb { width: 60px; height: 42px; }
        }

        /* Zone de candidature multi-sites */
        .pu-apply-title {
            margin-top: 0;
            margin-bottom: 0;
        }
        .pu-apply-sites {
            max-width: 360px;
            margin: 16px auto 24px;
            padding: 0 10px;
            text-align: center;
            color: #000;
        }
        .pu-apply-sites-count {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 999px;
            background: #000;
            color: #fff;
            font-family: ginkamedium, sans-serif;
            font-size: 14px;
        }
        .pu-apply-sites-text {
            margin: 12px 0 0;
            font-size: 15px;
            line-height: 1.5;
            color: #000;
        }

        /* Popup de la carte */
        #aac-locations-map .aac-map-popup .leaflet-popup-content-wrapper {
            padding: 0;
            border: 1px solid #000;
            border-radius: 0;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
            overflow: hidden;
        }
        #aac-locations-map .aac-map-popup .leaflet-popup-content {
            margin: 0;
            min-width: 260px;
            line-height: 1.4;
            color: #000;
        }
        #aac-locations-map .aac-map-popup .leaflet-popup-tip {
            box-shadow: none;
            border: 1px solid #000;
        }
        #aac-locations-map .aac-map-popup a.leaflet-popup-close-button {
            top: 8px;
            right: 8px;
            color: #000;
            font-size: 20px;
        }
        .aac-map-popup-head {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 36px 14px 16px;
            background: #f5f4f2;
            border-bottom: 1px solid #000;
        }
        #aac-locations-map .aac-map-popup-name {
            display: block;
            font-family: ginkamedium, sans-serif;
            font-size: 20px;
            font-weight: normal;
            line-height: 1.2;
            color: #000;
        }
        .aac-map-popup-number {
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #000;
            color: #fff;
            font-family: ginkamedium, sans-serif;
            font-size: 13px;
        }
        .aac-map-popup-badges {
            display: flex;
            gap: 6px;
            margin-top: 6px;
        }
        .aac-map-popup-badge {
            padding: 1px 7px;
            border: 1px solid #000;
            border-radius: 3px;
            font-size: 11px;
            letter-spacing: 0.03em;
            color: #000;
        }
        .aac-map-popup-badge--suspended {
            border-color: #b91c1c;
            color: #b91c1c;
        }
        .aac-map-popup-body {
            padding: 14px 16px 16px;
        }
        .aac-map-popup-line {
            display: flex;
            gap: 8px;
            margin-bottom: 6px;
            font-size: 13px;
            color: #000;
        }
        .aac-map-popup-line i {
            width: 14px;
            margin-top: 2px;
            text-align: center;
        }
        .aac-map-popup-suspended-notice {
            margin-top: 8px;
            padding: 8px 10px;
            background: #fee2e2;
            font-size: 12px;
            color: #991b1b;
        }
        .aac-map-popup-actions {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
            margin-top: 14px;
        }
        #aac-locations-map .aac-map-popup-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border: 1px solid #000;
            border-radius: 4px;
            background: #000;
            color: #fff;
            font-family: ginkamedium, sans-serif;
            font-size: 13px;
            text-decoration: none;
        }
        #aac-locations-map .aac-map-popup-btn:hover {
            background: #fff;
            color: #000;
        }
        #aac-locations-map .aac-map-popup-link {
            font-family: ginkamedium, sans-serif;
            font-size: 13px;
            color: #000;
            text-decoration: underline;
            text-underline-offset: 3px;
        }
        #aac-locations-map .aac-map-popup-link i {
            margin-left: 4px;
            font-size: 11px;
        }

        /* Repères numérotés de la carte */
        .aac-map-marker {
            background: none;
            border: 0;
        }
        .aac-map-marker span {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border: 2px solid #fff;
            border-radius: 50% 50% 50% 0;
            background: #000;
            color: #fff;
            font-family: ginkamedium, sans-serif;
            font-size: 15px;
            line-height: 1;
            transform: rotate(-45deg);
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
        }
        .aac-map-marker b {
            font-weight: normal;
            transform: rotate(45deg);
        }
        .aac-map-marker--suspended span {
            background: #9ca3af;
        }
        /* Accordéon des sites */
        .pu-sites-accordion {
            margin-top: 50px;
            color: #000;
        }
        .pu-site {
        
            background: #fff;
            scroll-margin-top: 100px;
        }
        .pu-site + .pu-site {
            margin-top: 24px;
        }
        .pu-site-summary {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 18px 22px;
            background: #f5f4f2;
            cursor: pointer;
            list-style: none;
            user-select: none;
        }
       
        .pu-site-summary::-webkit-details-marker {
            display: none;
        }
        
        .pu-site-summary:focus-visible {
            outline: 2px solid #000;
            outline-offset: 2px;
        }
        .pu-site-summary-main {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .pu-site-name {
            margin: 0;
            padding: 0;
            border: 0;
            font-family: ginkamedium, sans-serif;
            font-size: 28px;
            font-weight: normal;
            line-height: 1.2;
            text-transform: none;
            color: #000;
        }
        .pu-site-summary-meta {
            font-size: 14px;
            color: #000;
        }
        .pu-site-chevron {
            flex-shrink: 0;
            font-size: 18px;
            color: #000;
            transition: transform 0.2s ease;
        }
        .pu-site[open] .pu-site-chevron {
            transform: rotate(180deg);
        }
        .pu-site-body {
            padding: 4px 22px 24px;
        }
        .pu-site-body h4 {
            margin: 26px 0 10px;
            font-size: 18px;
        }
        .pu-site-summary-address {
            margin-top: 2px;
            font-size: 15px;
            color: #000;
        }
        .pu-site-summary-address .fas {
            margin-right: 6px;
        }
        .pu-site-body > h4:first-child {
            margin-top: 20px;
        }
        .pu-site-text {
            font-size: 15px;
            color: #000;
            line-height: 1.6;
        }
        .pu-site-text p {
            font-size: inherit;
        }
        .pu-site-text p:last-child {
            margin-bottom: 0;
        }
        .pu-site-text ul,
        .pu-site-text ol {
            margin: 0 0 10px;
            padding-left: 22px;
        }
        .pu-site-text ul:last-child,
        .pu-site-text ol:last-child {
            margin-bottom: 0;
        }
        .pu-site-text li {
            font-size: inherit;
            line-height: 1.6;
            color: #000;
        }
        .pu-site-visits {
            list-style: none;
            margin: 0;
            padding: 0;
            font-size: 15px;
            color: #000;
        }
        .pu-site-visits li {
            padding: 2px 0;
        }
        .pu-site-visits .fas {
            margin-right: 8px;
        }
        .pu-site-note {
            margin: 6px 0 0;
            font-size: 13px;
            color: #000;
        }
        .pu-site-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 22px;
        }
        .pu-site-action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border: 1px solid #000;
            border-radius: 4px;
            background: #fff;
            color: #000;
            font-family: ginkamedium, sans-serif;
            font-size: 14px;
            font-weight: normal;
            line-height: 1.2;
            text-decoration: none;
            cursor: pointer;
        }
        .pu-site-action:hover,
        .pu-site-action:focus {
            background: #000;
            color: #fff;
            text-decoration: none;
        }
        .pu-site-action--primary {
            background: #000;
            color: #fff;
        }
        .pu-site-action--primary:hover,
        .pu-site-action--primary:focus {
            background: #fff;
            color: #000;
        }
        @media (max-width: 767px) {
            .pu-site-summary {
                flex-wrap: wrap;
            }
            .pu-site-name {
                font-size: 24px;
            }
            .pu-site-summary {
                padding: 14px 16px;
            }
            .pu-site-body {
                padding: 4px 16px 20px;
            }
        }
        .pu-location-index {
            flex-shrink: 0;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #000;
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .pu-location-badges {
            display: flex;
            gap: 6px;
            flex-shrink: 0;
        }
        .pu-badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 3px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.03em;
        }
        .pu-badge--erp {
            border: 1px solid #000;
            background: #fff;
            color: #000;
        }
        .pu-badge--suspended {
            background: #fee2e2;
            color: #b91c1c;
        }
        .pu-location-suspension-notice {
            margin-top: 12px;
            padding: 10px 12px;
            background: #fee2e2;
            border: 1px solid #fca5a5;
            border-radius: 4px;
            display: flex;
            gap: 8px;
            align-items: flex-start;
            font-size: 13px;
            color: #991b1b;
        }
        .pu-location-suspension-notice .fa {
            flex-shrink: 0;
            margin-top: 2px;
        }

        .aac-map-hint {
            margin-bottom: 12px;
            font-size: 14px;
        }
        #aac-locations-map {
            height: 420px;
            margin-bottom: 0;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: #f5f5f5;
        }
        #aac-locations-map .leaflet-container {
            height: 100%;
            width: 100%;
            border-radius: 4px;
        }
    </style>
    {% if space.isMultiLocation and space.locations|length > 0 %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    {% endif %}
{% endblock %}

{% block javascript %}
    {{ parent() }}
    {% if space.isMultiLocation and space.locations|length > 0 %}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    {% endif %}
    <script>
        $(document).ready(function () {
            /* Sync vignettes → carousel */
            $('.pu-gallery-thumb').on('click', function () {
                var idx = $(this).data('slide-to');
                $('#spaceCarousel').carousel(idx);
            });

            /* Sync carousel → vignettes */
            $('#spaceCarousel').on('slid.bs.carousel', function () {
                var active = $(this).find('.item.active');
                var idx = active.index();
                $('.pu-gallery-thumb').removeClass('active').eq(idx).addClass('active');
            });

            {% if space.isMultiLocation and space.locations|length > 0 %}
            initSitesAccordion();
            initAacLocationsMap();
            {% endif %}
        });

        {% if space.isMultiLocation and space.locations|length > 0 %}
        var aacSitesMap = { map: null, markers: {} };

        function openSite(id) {
            var site = document.getElementById('site-' + id);
            if (!site) {
                return;
            }
            site.open = true;
            site.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function initSitesAccordion() {
            $(document).on('click', '.js-open-site', function (e) {
                e.preventDefault();
                if (aacSitesMap.map) {
                    aacSitesMap.map.closePopup();
                }
                openSite($(this).data('site-id'));
            });

            $(document).on('click', '.js-show-site-on-map', function () {
                var mapEl = document.getElementById('aac-locations-map');
                var marker = aacSitesMap.markers[$(this).data('location-id')];
                if (mapEl) {
                    mapEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                if (marker && aacSitesMap.map) {
                    aacSitesMap.map.setView(marker.getLatLng(), 15, { animate: false });
                    marker.openPopup();
                }
            });

            var match = /^#site-(\d+)$/.exec(window.location.hash);
            if (match) {
                openSite(match[1]);
            }
        }

        function initAacLocationsMap() {
            var mapEl = document.getElementById('aac-locations-map');
            if (typeof L === 'undefined' || !mapEl) {
                $('.js-show-site-on-map').hide();
                return;
            }

            var locations = [
                {% for location in space.locations %}
                {
                    id: {{ location.id }},
                    number: {{ loop.index }},
                    name: {{ location.name|json_encode|raw }},
                    lat: {{ location.latitude ?? 'null' }},
                    lng: {{ location.longitude ?? 'null' }},
                    address: {{ location.address|default('')|json_encode|raw }},
                    zipCode: {{ location.zipCode|default('')|json_encode|raw }},
                    city: {{ location.city|default('')|json_encode|raw }},
                    fullAddress: {{ location.fullAddress|json_encode|raw }},
                    availability: {{ location.availability|default('')|json_encode|raw }},
                    isErp: {{ location.isErp ? 'true' : 'false' }},
                    suspended: {{ location.suspended ? 'true' : 'false' }},
                    suspensionMessage: {{ location.suspensionMessage|default('')|json_encode|raw }},
                    aacDocumentUrl: {{ location.aacDocumentName ? vich_uploader_asset(location, 'aacDocument')|json_encode|raw : 'null' }}
                }{% if not loop.last %},{% endif %}
                {% endfor %}
            ];

            var map = L.map(mapEl).setView([46.6, 2.4], 6);
            aacSitesMap.map = map;
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            var bounds = [];
            var pending = 0;

            function escapeHtml(text) {
                var div = document.createElement('div');
                div.textContent = text || 'Site';
                return div.innerHTML;
            }

            function buildPopupContent(loc) {
                var badges = '';
                if (loc.isErp) {
                    badges += '<span class="aac-map-popup-badge">ERP</span>';
                }
                if (loc.suspended) {
                    badges += '<span class="aac-map-popup-badge aac-map-popup-badge--suspended">Suspendu</span>';
                }

                var html = '<div class="aac-map-popup-head">'
                    + '<span class="aac-map-popup-number">' + loc.number + '</span>'
                    + '<div><span class="aac-map-popup-name">' + escapeHtml(loc.name) + '</span>'
                    + (badges ? '<div class="aac-map-popup-badges">' + badges + '</div>' : '')
                    + '</div></div>';

                html += '<div class="aac-map-popup-body">';
                if (loc.fullAddress) {
                    html += '<div class="aac-map-popup-line"><i class="fas fa-location-dot"></i><span>' + escapeHtml(loc.fullAddress) + '</span></div>';
                }
                if (loc.availability) {
                    html += '<div class="aac-map-popup-line"><i class="far fa-clock"></i><span>Durée du projet\u00a0: ' + escapeHtml(loc.availability) + '</span></div>';
                }
                if (loc.suspended) {
                    var msg = loc.suspensionMessage || 'Candidatures suspendues pour ce site.';
                    html += '<div class="aac-map-popup-suspended-notice">' + escapeHtml(msg) + '</div>';
                }

                html += '<div class="aac-map-popup-actions">';
                if (loc.aacDocumentUrl) {
                    html += '<a class="aac-map-popup-btn" href="' + escapeHtml(loc.aacDocumentUrl) + '" target="_blank" rel="noopener"><i class="far fa-file-pdf"></i> Appel à candidatures</a>';
                }
                html += '<a class="aac-map-popup-link js-open-site" href="#site-' + loc.id + '" data-site-id="' + loc.id + '">Voir le détail du site <i class="fas fa-arrow-right"></i></a>';
                html += '</div></div>';

                return html;
            }

            var coordinatesUsed = {};

            function addMarker(loc, lat, lng) {
                var key = lat.toFixed(6) + ',' + lng.toFixed(6);
                if (coordinatesUsed[key]) {
                    var count = coordinatesUsed[key];
                    var angle = (count * 2 * Math.PI) / 8;
                    var radius = 0.00015 * Math.sqrt(count);
                    lat += Math.sin(angle) * radius;
                    lng += Math.cos(angle) * radius;
                    coordinatesUsed[key]++;
                } else {
                    coordinatesUsed[key] = 1;
                }

                var marker = L.marker([lat, lng], {
                    icon: L.divIcon({
                        className: 'aac-map-marker' + (loc.suspended ? ' aac-map-marker--suspended' : ''),
                        html: '<span><b>' + loc.number + '</b></span>',
                        iconSize: [34, 34],
                        iconAnchor: [17, 41],
                        popupAnchor: [0, -44]
                    }),
                    title: loc.number + '. ' + (loc.name || 'Site'),
                    riseOnHover: true
                }).addTo(map);
                marker.bindPopup(buildPopupContent(loc), { maxWidth: 320, minWidth: 260, className: 'aac-map-popup', autoPanPaddingTopLeft: [60, 20], autoPanPaddingBottomRight: [20, 20] });
                aacSitesMap.markers[loc.id] = marker;
                bounds.push([lat, lng]);
            }

            function finalizeMap() {
                $('.js-show-site-on-map').each(function () {
                    $(this).toggle(!!aacSitesMap.markers[$(this).data('location-id')]);
                });
                if (bounds.length === 1) {
                    map.setView(bounds[0], 14);
                } else if (bounds.length > 1) {
                    map.fitBounds(bounds, { padding: [30, 30] });
                }
                setTimeout(function () { map.invalidateSize(); }, 200);
            }

            locations.forEach(function (loc) {
                if (loc.lat !== null && loc.lng !== null && !isNaN(loc.lat) && !isNaN(loc.lng)) {
                    addMarker(loc, loc.lat, loc.lng);
                    return;
                }

                if (!loc.city && !loc.zipCode && !loc.address) {
                    return;
                }

                pending++;
                $.ajax({
                    url: '{{ path('api_geocode') }}',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        address: loc.address,
                        zipCode: loc.zipCode,
                        city: loc.city
                    })
                }).done(function (data) {
                    if (data.lat && data.lng) {
                        addMarker(loc, data.lat, data.lng);
                    }
                }).always(function () {
                    pending--;
                    if (pending === 0) {
                        finalizeMap();
                    }
                });
            });

            if (pending === 0) {
                finalizeMap();
            }
        }
        {% endif %}
    </script>
{% endblock %}
